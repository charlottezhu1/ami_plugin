{
    "manifest_version": 3,
    "name": "AMI",
    "description": "Affect Mix Index",
    "version": "1.0",
    "icons": {
        "16": "icon/image16.png",
        "32": "icon/image32.png",
        "48": "icon/image48.png",
        "64": "icon/image64.png",
        "128": "icon/image128.png"
    },

    "permissions": ["tabs", "storage"],
    "host_permissions": [
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "http://localhost:5050/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "*://*.twitter.com/*",
                "*://*.x.com/*"
            ],
            "js": [
                "sentiment.js",
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_icon": "icon/image128.png"
    }
}
